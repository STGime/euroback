# Eurobase Console — SvelteKit build
# Node.js adapter for server-side rendering

FROM node:22-alpine AS builder
# Mirror the repo layout so relative imports from
# console/src/lib/legal.ts into `../../../docs/legal/v2/*.md?raw`
# resolve the same way they do on a dev laptop. Without this the
# Vite build fails with `Could not resolve "../../../docs/legal/v2/
# dpa.md?raw"` — the earlier console-only WORKDIR had no sibling
# docs/ tree.
WORKDIR /repo
COPY console/package*.json ./console/
WORKDIR /repo/console
RUN npm ci
WORKDIR /repo
COPY console/ ./console/
# Legal-doc sources bundled at build time via Vite `?raw`. Scoped
# to docs/legal/ only — no need to drag the rest of docs/ into
# the image.
COPY docs/legal/ ./docs/legal/
WORKDIR /repo/console
ENV PUBLIC_API_URL=https://api.eurobase.app
ARG BUILD_SHA=unknown
ENV PUBLIC_BUILD_SHA=$BUILD_SHA
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /repo/console/build ./build
COPY --from=builder /repo/console/package.json .
ENV PORT=3000
ENV ORIGIN=https://console.eurobase.app
EXPOSE 3000
CMD ["node", "build/index.js"]
