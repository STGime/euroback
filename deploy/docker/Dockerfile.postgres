# Custom PostgreSQL with pgTAP for database testing
FROM postgres:16-alpine

# Install build dependencies, compile pgTAP, clean up.
# `patch` is needed for pgTAP's compat/install-*.patch steps in the
# upstream Makefile — without it the build fails with
# `/bin/sh: patch: not found` before any SQL is emitted (alpine's
# base image doesn't ship patch, unlike debian).
RUN apk add --no-cache --virtual .build-deps \
        make \
        perl \
        git \
        patch \
    && git clone --depth 1 https://github.com/theory/pgtap.git /tmp/pgtap \
    && cd /tmp/pgtap \
    && make \
    && make install \
    && cd / \
    && rm -rf /tmp/pgtap \
    && apk del .build-deps
